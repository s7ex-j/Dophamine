{
  "expo": {
    "name": "Dophamine",
    "slug": "dophamine",
    "scheme": "dophamine",
    "version": "0.9.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Dophamine usa la cámara solo para leer el código de barras de un producto. La imagen no se guarda.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/Dophamine/app"
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "android": {
      "package": "com.s7ex.dophamine",
      "versionCode": 1,
      "permissions": [
        "android.permission.VIBRATE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.s7ex.dophamine",
      "buildNumber": "1"
    }
  }
}
