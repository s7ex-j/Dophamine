{
  "expo": {
    "name": "Dophamine",
    "slug": "dophamine",
    "owner": "s7exjs-team",
    "scheme": "dophamine",
    "version": "0.38.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Dophamine usa tus fotos solo si eliges una foto de progreso. Se copia a la carpeta privada de la app.",
          "cameraPermission": "Dophamine usa la cámara para leer códigos de barras y, si tú quieres, para tus fotos de progreso."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Dophamine usa la cámara para leer códigos de barras y el código QR de la conexión directa con la web. La imagen no se guarda.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#34D399"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0E1311"
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Dophamine usa la cámara para leer el código QR de la conexión directa con la web. La imagen no se guarda.",
          "microphonePermission": "Dophamine no usa el micrófono."
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/Dophamine/app"
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "android": {
      "package": "com.s7ex.dophamine",
      "versionCode": 1,
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#167B5B"
      }
    },
    "ios": {
      "bundleIdentifier": "com.s7ex.dophamine",
      "buildNumber": "1"
    },
    "backgroundColor": "#0E1311",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "250a8583-7556-49f2-8bb1-2ec69190343a"
      }
    }
  }
}
