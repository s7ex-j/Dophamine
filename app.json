{
  "expo": {
    "name": "Dophamine",
    "slug": "dophamine",
    "owner": "s7exjs-team",
    "scheme": "dophamine",
    "version": "0.42.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Dophamine usa tus fotos solo si eliges una foto de progreso. Se copia a la carpeta privada de la app.",
          "cameraPermission": "Dophamine usa la cámara para leer códigos de barras y, si tú quieres, para tus fotos de progreso."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Dophamine usa la cámara para leer códigos de barras y el código QR de la conexión directa con la web. La imagen no se guarda.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#34D399"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0E1311"
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Dophamine usa la cámara para leer el código QR de la conexión directa con la web. La imagen no se guarda.",
          "microphonePermission": "Dophamine usa el micrófono solo si dictas un alimento; la voz se reconoce en el teléfono."
        }
      ],
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class org.webrtc.** { *; }\n-dontwarn org.webrtc.**",
            "minSdkVersion": 26
          }
        }
      ],
      "react-native-health-connect",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Dophamine usa el micrófono solo si dictas un alimento; la voz se reconoce en el teléfono.",
          "speechRecognitionPermission": "Para entender el alimento que dictas, en el teléfono."
        }
      ],
      "./plugins/withUsageAccess",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Today",
              "label": "Dophamine · Hoy",
              "description": "Lo que te queda del día, agua y pasos",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "react-native-fast-tflite",
      "./plugins/withPhoneArchitectures"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/Dophamine/app"
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "android": {
      "package": "com.s7ex.dophamine",
      "versionCode": 4200,
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_NUTRITION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#167B5B"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.BLUETOOTH"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.s7ex.dophamine",
      "buildNumber": "1"
    },
    "backgroundColor": "#0E1311",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "250a8583-7556-49f2-8bb1-2ec69190343a"
      }
    }
  }
}
