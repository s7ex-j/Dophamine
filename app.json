{
  "expo": {
    "name": "Dophamine",
    "slug": "dophamine",
    "scheme": "dophamine",
    "version": "0.20.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Dophamine usa tus fotos solo si eliges una foto de progreso. Se copia a la carpeta privada de la app.",
          "cameraPermission": "Dophamine usa la cámara para leer códigos de barras y, si tú quieres, para tus fotos de progreso."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Dophamine usa la cámara solo para leer el código de barras de un producto. La imagen no se guarda.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#34D399"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/Dophamine/app"
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "android": {
      "package": "com.s7ex.dophamine",
      "versionCode": 1,
      "permissions": [
        "android.permission.VIBRATE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.s7ex.dophamine",
      "buildNumber": "1"
    },
    "backgroundColor": "#0E1311"
  }
}
